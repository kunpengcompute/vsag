+        dists3 = 1 - (lb * (query_sum + code_sum3) + scalar_rate_ * raw_ip[2] + lb2);
+        dists4 = 1 - (lb * (query_sum + code_sum4) + scalar_rate_ * raw_ip[3] + lb2);
