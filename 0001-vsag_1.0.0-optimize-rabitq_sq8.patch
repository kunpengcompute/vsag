+float
+BinaryIPFromLookupLocal(const float* lookup, const uint8_t* bits, uint64_t dim) {
+    const uint64_t plane_bytes = (dim + 7) / 8;
+    float result = 0.0F;
+    for (uint64_t block = 0; block < plane_bytes; ++block) {
+        result += lookup[(block << 8) + bits[block]];
+    }
+    return result;
+}
